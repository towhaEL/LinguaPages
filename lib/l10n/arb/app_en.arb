  "onboardingLibraryTitle": "Every book you own, on one shelf",
  "onboardingLibraryBody": "Bring in EPUB, PDF, TXT, Markdown, HTML and FB2 files, or open them with OpenPages from any app.",
  "onboardingLibraryImport": "Import from your files",
